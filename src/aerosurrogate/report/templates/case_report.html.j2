<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ row.case_id }} | aero-surrogate case report</title>
<style>
 :root { --fg:#1d232b; --muted:#5b6673; --line:#d8dde3; --ok:#1f7a4d; --warn:#9a6700; --bad:#b42318; --bg:#ffffff; --panel:#f6f8fa; }
 body { font: 15px/1.5 system-ui, -apple-system, Segoe UI, Roboto, sans-serif; color: var(--fg); background: var(--bg); margin: 0 auto; max-width: 1100px; padding: 24px 16px 64px; }
 h1 { font-size: 22px; margin: 0 0 4px; } h2 { font-size: 17px; margin: 28px 0 8px; border-bottom: 1px solid var(--line); padding-bottom: 4px; }
 .muted { color: var(--muted); } .badge { display:inline-block; padding: 2px 8px; border-radius: 10px; font-size: 13px; color: #fff; }
 .ok { background: var(--ok); } .warn { background: var(--warn); } .bad { background: var(--bad); }
 table { border-collapse: collapse; font-size: 14px; } td, th { border-bottom: 1px solid var(--line); padding: 4px 12px 4px 0; text-align: left; vertical-align: top; }
 td.num { font-variant-numeric: tabular-nums; }
 .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px; }
 .panel { background: var(--panel); border: 1px solid var(--line); border-radius: 6px; padding: 10px 14px; }
 img { max-width: 100%; height: auto; border: 1px solid var(--line); border-radius: 4px; }
 .risk li { margin-bottom: 4px; } code { font-size: 13px; }
</style></head><body>
<h1>Case {{ row.case_id }}</h1>
<div class="muted">{{ provenance }}</div>
<p>Status:
 {% if row.status == 'ok' %}<span class="badge ok">converged</span>
 {% elif row.status == 'not_converged' %}<span class="badge warn">not converged (window means reported)</span>
 {% else %}<span class="badge bad">{{ row.status }}</span>{% endif %}
 {% if row.stop_reason %}<span class="muted"> ({{ row.stop_reason }})</span>{% endif %}
</p>
{% if row.failure_reason %}<div class="panel"><b>Failure:</b> {{ row.failure_reason }}</div>{% endif %}

<h2>Force coefficients</h2>
<div class="grid">
<div class="panel"><table>
 <tr><th>CL</th><td class="num">{{ "%.4f"|format(row.cl) }} &plusmn; {{ "%.4f"|format(row.cl_std) }}</td></tr>
 <tr><th>Downforce coefficient (&minus;CL)</th><td class="num">{{ "%.4f"|format(-row.cl) }}</td></tr>
 <tr><th>CD</th><td class="num">{{ "%.5f"|format(row.cd) }} &plusmn; {{ "%.5f"|format(row.cd_std) }}</td></tr>
 <tr><th>CM (nose-up +, main c/4)</th><td class="num">{{ "%.4f"|format(row.cm) }} &plusmn; {{ "%.4f"|format(row.cm_std) }}</td></tr>
 <tr><th>|CL|/CD</th><td class="num">{{ "%.2f"|format((row.cl|abs) / row.cd if row.cd else 0) }}</td></tr>
</table><p class="muted">&plusmn; = standard deviation over the last {{ window }} iterations (iterative unsteadiness, not total uncertainty).</p></div>
<div class="panel"><table>
 <tr><th>Iterations</th><td class="num">{{ row.n_iter }}</td></tr>
 <tr><th>Final max initial residual</th><td class="num">{{ "%.2e"|format(row.residual_final) }}</td></tr>
 <tr><th>Solver wall clock</th><td class="num">{{ "%.1f"|format(row.wall_clock_s) }} s on {{ row.n_procs }} cores</td></tr>
 <tr><th>y+ max / mean (wing)</th><td class="num">{{ "%.1f"|format(row.y_plus_max) }} / {{ "%.1f"|format(row.y_plus_mean or 0) }}</td></tr>
</table></div>
</div>
{% if elements %}<h3>Per-element contributions</h3><table><tr><th>element</th><th>CL</th><th>CD</th><th>CM</th></tr>
{% for e in elements %}<tr><td>{{ e.element }}</td><td class="num">{{ "%.4f"|format(e.cl) }}</td><td class="num">{{ "%.5f"|format(e.cd) }}</td><td class="num">{{ "%.4f"|format(e.cm) }}</td></tr>{% endfor %}</table>{% endif %}

<h2>Setup</h2>
<div class="grid">
<div class="panel"><table>
{% for k, v in setup.items() %}<tr><th>{{ k }}</th><td>{{ v }}</td></tr>{% endfor %}
</table></div>
<div class="panel"><b>Mesh quality (checkMesh)</b><table>
{% for k, v in checkmesh.items() %}<tr><th>{{ k }}</th><td class="num">{{ v }}</td></tr>{% endfor %}
</table></div>
</div>

{% for title, img in figures %}<h2>{{ title }}</h2><img alt="{{ title }}" src="data:image/png;base64,{{ img }}">{% endfor %}

{% if gci %}<h2>Mesh convergence (GCI, Celik et al. 2008)</h2>
<table><tr><th>quantity</th><th>fine / medium / coarse</th><th>observed order p</th><th>extrapolated</th><th>GCI fine</th><th>oscillatory</th></tr>
{% for name, g in gci.items() %}<tr><td>{{ name }}</td><td class="num">{{ "%.4f"|format(g.phi1) }} / {{ "%.4f"|format(g.phi2) }} / {{ "%.4f"|format(g.phi3) }}</td><td class="num">{{ "%.2f"|format(g.p) }}</td><td class="num">{{ "%.4f"|format(g.phi_ext) }}</td><td class="num">{{ "%.2f"|format(100*g.gci_fine) }} %</td><td>{{ g.oscillatory }}</td></tr>{% endfor %}
</table>{% endif %}

<h2>Known risks (carried into every report)</h2>
<ol class="risk">
<li>RANS accuracy on separated multi-element flow near a moving ground is uncertain; a surrogate inherits this CFD error.</li>
<li>Validation needs published ground-effect wing data and STAR-CCM+ runs; see docs/phase0_report.md for what has been validated so far.</li>
<li>Smoke-test meshes are coarse (wall functions, few boundary-layer layers); numbers here are pipeline checks, not design data.</li>
<li>Blunt trailing edges are thinned (te_thickness) for steady convergence; this changes CL measurably (Phase 0 found ~16 % at h/c = 0.2).</li>
</ol>
<p class="muted">Generated by aerosurrogate {{ version }} at {{ row.created_utc }}. Case folder: <code>{{ case_dir }}</code></p>
</body></html>
