FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
solvers
{
    p
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-8;
        relTol          0.05;
    }
    "(U|k|omega)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-9;
        relTol          0.1;
    }
}
SIMPLE
{
    nNonOrthogonalCorrectors {{ solver.n_non_orth }};
    consistent      {{ 'yes' if solver.simplec else 'no' }};
    residualControl
    {
        p               {{ solver.residual_tol }};
        U               {{ solver.residual_tol }};
        "(k|omega)"     {{ solver.residual_tol }};
    }
}
relaxationFactors
{
    fields          { p {{ solver.relax_p }}; }
    equations       { U {{ solver.relax_u }}; "(k|omega)" {{ solver.relax_turb }}; }
}
