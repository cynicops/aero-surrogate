FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
dimensions      [0 1 -1 0 0 0 0];
internalField   uniform ({{ u_inf }} 0 0);
boundaryField
{
    inlet   { type fixedValue; value uniform ({{ u_inf }} 0 0); }
    outlet  { type inletOutlet; inletValue uniform (0 0 0); value uniform ({{ u_inf }} 0 0); }
    top     { type slip; }
{% if ground_moving %}
    ground  { type fixedValue; value uniform ({{ u_inf }} 0 0); }   // moving ground, belt speed = U_inf
{% else %}
    ground  { type slip; }
{% endif %}
    "element.*" { type noSlip; }
    "(front|back)" { type empty; }
}
