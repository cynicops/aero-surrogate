FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
dimensions      [0 2 -2 0 0 0 0];
internalField   uniform {{ k_inf }};
boundaryField
{
    inlet   { type fixedValue; value uniform {{ k_inf }}; }
    outlet  { type inletOutlet; inletValue uniform {{ k_inf }}; value uniform {{ k_inf }}; }
    top     { type zeroGradient; }
{% if ground_moving %}
    ground  { type kqRWallFunction; value uniform {{ k_inf }}; }
{% else %}
    ground  { type zeroGradient; }
{% endif %}
    "element.*" { type kqRWallFunction; value uniform {{ k_inf }}; }
    "(front|back)" { type empty; }
}
